# Provider chain, tried left to right. A provider without credentials is skipped.
# "mock" is an offline, deterministic provider: perfect for CI and demos without internet.
LLM_PROVIDERS=groq,gemini,ollama,mock

# Groq free tier  -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini free tier -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (fully local) -> `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Resilience / throughput knobs
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.8
LLM_TIMEOUT_S=60
MAX_CONCURRENCY=3
MAX_TASKS=12
OUTPUT_DIR=outputs
